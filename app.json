{
  "expo": {
    "name": "Taskly",
    "slug": "ExpoToDoApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "src/assets/Icons/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zaidi8.ExpoToDoApp"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "src/assets/Icons/icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.zaidi8.ExpoToDoApp"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "src/assets/Icons/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "src/assets/Icons/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "4333feea-0c91-4ea6-894d-bca07d06800f"
      }
    }
  }
}
